# Razorpay test credentials. Copy this file to .env.local and replace the placeholders.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# The backend owns the payable amount. ₹100 = 10,000 paise.
PAYMENT_AMOUNT_IN_PAISE=10000
PORT=8787

# Add the deployed frontend origin and local Vite origin.
ALLOWED_ORIGINS=http://localhost:5173,https://manikandansugu.github.io

# Set this only in the deployed frontend build when the API is on another origin.
VITE_API_BASE_URL=
